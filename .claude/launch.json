{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "engine-out",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const http=require('http'),fs=require('fs'),path=require('path');const root=path.resolve('packages/engine/out');http.createServer((q,r)=>{const f=path.join(root,decodeURIComponent(q.url.split('?')[0]));if(!f.startsWith(root)){r.writeHead(403);return r.end();}fs.readFile(f,(e,d)=>{if(e){r.writeHead(404);return r.end();}r.writeHead(200,{'Content-Type':'text/html; charset=utf-8'});r.end(d);});}).listen(5180,'127.0.0.1');"
      ],
      "port": 5180
    }
  ]
}
